# ============================================================
# Vibe-Trader environment template
# Copy this file to .env and fill in the keys you have.
# Every key is optional — but you need at least ONE AI provider.
# ============================================================

# ---- AI provider (pick at least one) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# For local models via Ollama (free, runs on your machine):
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Market data providers (all have free tiers) ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
POLYGON_API_KEY=
TUSHARE_TOKEN=

# ---- Vibe-Trading options ----
# Cache historical market data locally (faster repeat runs)
VIBE_TRADING_DATA_CACHE=1
# Enable scheduled/recurring research runs
# VIBE_TRADING_ENABLE_SCHEDULER=1
# Required only if you expose the API to other machines
# API_AUTH_KEY=
